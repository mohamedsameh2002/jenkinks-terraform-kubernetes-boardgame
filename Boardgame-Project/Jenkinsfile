pipeline {

    agent any

    tools {
        jdk 'jdk17'
        maven 'maven3'
    }

    environment {

        SCANNER_HOME = tool 'sonar-scanner'

        AWS_REGION = 'us-east-1'
        EKS_CLUSTER_NAME = 'retail-dev-eksdemo'

        ECR_REGISTRY = '358592703668.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO = 'jenkins-repo'

        IMAGE = "${ECR_REGISTRY}/${ECR_REPO}"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Compile') {
            steps {
                dir('Boardgame-Project') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Boardgame-Project') {
                    sh 'mvn test'
                }
            }
        }

        stage('File System Scan Trivy') {
            steps {
                sh '''
                    trivy fs \
                    --format table \
                    -o trivy-fs-report.html \
                    .
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Boardgame-Project') {
                    withSonarQubeEnv('sonar') {
                        sh '''
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=BoardGame \
                            -Dsonar.projectKey=BoardGame \
                            -Dsonar.java.binaries=target/classes
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                waitForQualityGate(
                    abortPipeline: false,
                    credentialsId: 'sonar-token'
                )
            }
        }

        stage('Build') {
            steps {
                dir('Boardgame-Project') {
                    sh 'mvn package'
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('Boardgame-Project') {
                    withMaven(
                        globalMavenSettingsConfig: 'global-settings',
                        jdk: 'jdk17',
                        maven: 'maven3',
                        traceability: true
                    ) {
                        sh 'mvn deploy'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                    -t ${IMAGE}:${IMAGE_TAG} \
                    -t ${IMAGE}:latest \
                    Boardgame-Project
                '''
            }
        }

        stage('Docker Image Scan Trivy') {
            steps {
                sh '''
                    trivy image \
                    --format table \
                    -o trivy-image-report.html \
                    ${IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password \
                    --region ${AWS_REGION} | \
                    docker login \
                    --username AWS \
                    --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Push Images') {
            steps {
                sh '''
                    docker push ${IMAGE}:${IMAGE_TAG}
                    docker push ${IMAGE}:latest
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                    --region ${AWS_REGION} \
                    --name ${EKS_CLUSTER_NAME}

                    sed -i "s|image:.*|image: ${IMAGE}:${IMAGE_TAG}|" \
                    Boardgame-Project/deployment.yaml

                    kubectl apply \
                    -f Boardgame-Project/deployment.yaml

                    kubectl rollout status \
                    deployment/boardgame \
                    --timeout=5m
                '''
            }
        }
    }

    post {

        always {

            emailext(
                subject: "${JOB_NAME} - Build ${BUILD_NUMBER} - ${currentBuild.result ?: 'UNKNOWN'}",

                body: """
                    <html>
                    <body>

                        <h2>${JOB_NAME} - Build ${BUILD_NUMBER}</h2>

                        <p>
                            Pipeline Status:
                            <b>${currentBuild.result ?: 'UNKNOWN'}</b>
                        </p>

                        <p>
                            Check the
                            <a href="${BUILD_URL}">
                                console output
                            </a>.
                        </p>

                    </body>
                    </html>
                """,

                to: 'mohamed.403.sameh@gmail.com',

                mimeType: 'text/html',

                attachmentsPattern: 'trivy-image-report.html'
            )
        }
    }
}

